[Script]
http-response ^https?:\/\/api3\.gifshow\.com\/rest\/n\/user\/login script-path=https://raw.githubusercontent.com/XiaoGe-LiBai/QX-Loon/refs/heads/main/Loon/Task/ks_salt.js, requires-body=true, timeout=15, tag=快手普通版salt
http-request ^https?:\/\/encourage\.kuaishou\.com\/rest\/wd\/encourage\/unionTask\/treasureBox\/info script-path=https://raw.githubusercontent.com/XiaoGe-LiBai/QX-Loon/refs/heads/main/Loon/Task/ks_cookie.js, timeout=10, tag=快手普通版Cookie
http-request ^https?:\/\/az4-api\.ksapisrv\.com\/rest\/n\/emotion\/package\/list\/v2 script-path=https://raw.githubusercontent.com/XiaoGe-LiBai/QX-Loon/refs/heads/main/Loon/Task/ks_kaw.js, timeout=10, tag=快手普通版kaw参数

[MITM]
hostname = api3.gifshow.com, encourage.kuaishou.com, az4-api.ksapisrv.com


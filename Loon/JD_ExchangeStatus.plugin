#!name = 京东金融积分商城
#!author = 菜狗
#!desc = 修改京东金融积分商城 exchangeDetailStatus 状态值为 1，并提供优惠券快速跳转面板
#!date = 2026-02-05
#!icon = https://raw.githubusercontent.com/XiaoGe-LiBai/QX-Loon/713de1117924c559e89034c8c3cc4ae26c4d89fb/Photos/jdjr.png
#!openUrl = https://apps.apple.com/cn/app/id895682747

[Argument]
enableModify = switch,true,tag=启用状态修改,desc=是否启用 exchangeDetailStatus 状态修改功能

[Panel]
京东金融优惠券 = script-name=京东金融积分商城, update-interval=-1

[Script]
http-response ^https?:\/\/ms\.jr\.jd\.com\/gw2\/generic\/nPointMall\/newh5\/m\/gateMallProductDetail script-path=https://raw.githubusercontent.com/XiaoGe-LiBai/QX-Loon/refs/heads/main/Loon/Task/JD_ExchangeStatus.js, requires-body=true, timeout=30, tag=修改兑换状态, enable={enableModify}
京东金融积分商城 = type=generic, timeout=10, script-path=https://raw.githubusercontent.com/XiaoGe-LiBai/QX-Loon/refs/heads/main/Loon/Task/JD_ExchangeStatus.js

[MITM]
hostname = ms.jr.jd.com

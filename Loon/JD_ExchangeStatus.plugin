[script]
http-response ^https?:\/\/ms\.jr\.jd\.com\/gw2\/generic\/nPointMall\/newh5\/m\/gateMallProductDetail script-path=https://raw.githubusercontent.com/XiaoGe-LiBai/QX-Loon/refs/heads/main/Loon/Task/JD_ExchangeStatus.js, requires-body=true, timeout=30, tag=修改兑换状态
http-response ^https?:\/\/ms\.jr\.jd\.com\/gw\/generic\/zc\/h5\/m\/queryBenefit script-path=https://raw.githubusercontent.com/XiaoGe-LiBai/QX-Loon/refs/heads/main/Loon/Task/JD_QueryBenefit.js, requires-body=true, timeout=30, tag=修改白条权益状态

[mitm]
hostname = ms.jr.jd.com

#!name = 京东Cookie/wskey提取与Bncr同步
#!author = XiaoGe-LiBai
#!desc = 抓取京东：api.m.jd.com 取 pt_key/pt_pin，sh.jd.com/d 取 wskey；跨请求自动拼装 pin 与 wskey，并同步给服务器。
#!icon = https://raw.githubusercontent.com/XiaoGe-LiBai/QX-Loon/main/Photos/jd.png
#!openUrl = https://apps.apple.com/cn/app/id414245413
#!tag = 京东,抓包,wskey,Bncr,自动化
#!date = 2026-09-16

[Argument]
upload = switch, true, false, tag=自动上传, desc=关闭后只抓取与弹窗，不自动同步服务器
notifyWskey = switch, true, false, tag=弹窗：wskey, desc=抓到新 wskey 时弹窗，点击可复制(变化才弹)
notifyPtKey = switch, true, false, tag=弹窗：pt_key, desc=抓appck时弹窗，点击可复制

[Rule]
# 两个回调域名（bncr.xiaoge.ink / bncr2.xiaoge.ink）都在 Cloudflare 上，A/AAAA 均可达。
# 保留直连：回调不依赖代理节点是否可用，也免去一次代理往返。
DOMAIN-SUFFIX,xiaoge.ink,DIRECT

[Script]
http-request ^https?:\/\/api\.m\.jd\.com\/ script-path=https://raw.githubusercontent.com/XiaoGe-LiBai/QX-Loon/main/Loon/Task/jd_cookie.js, argument=[{upload}, {notifyWskey}, {notifyPtKey}], requires-body=false, timeout=60, tag=京东Cookie-pin
http-request ^https?:\/\/sh\.jd\.com\/d script-path=https://raw.githubusercontent.com/XiaoGe-LiBai/QX-Loon/main/Loon/Task/jd_cookie.js, argument=[{upload}, {notifyWskey}, {notifyPtKey}], requires-body=false, timeout=60, tag=京东Cookie-wskey

[MITM]
hostname = api.m.jd.com, sh.jd.com

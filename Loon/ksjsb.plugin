#!name = 快手极速版数据抓取
#!author = 菜狗
#!desc = 抓取快手极速版的 salt、cookie、UA 和 kaw 参数
#!date = 2025-10-31
#!icon = https://raw.githubusercontent.com/XiaoGe-LiBai/QX-Loon/713de1117924c559e89034c8c3cc4ae26c4d89fb/Photos/ksjsb.png
#!openUrl = https://apps.apple.com/cn/app/id1472502819

[Script]
http-response ^https?:\/\/api3\.ksapisrv\.com\/rest\/nebula\/user\/login script-path=https://raw.githubusercontent.com/XiaoGe-LiBai/QX-Loon/refs/heads/main/Loon/Task/ksjsb_salt.js, requires-body=true, timeout=15, tag=快手极速版salt
http-request ^https?:\/\/nebula\.kuaishou\.com\/rest\/n\/nebula\/activity\/earn\/overview\/tasks script-path=https://raw.githubusercontent.com/XiaoGe-LiBai/QX-Loon/refs/heads/main/Loon/Task/ksjsb_cookie.js, timeout=10, tag=快手极速版Cookie和UA
http-request ^https?:\/\/api\.e\.kuaishou\.com\/rest\/e\/neo\/mixed\/ad script-path=https://raw.githubusercontent.com/XiaoGe-LiBai/QX-Loon/refs/heads/main/Loon/Task/ksjsb_kaw.js, timeout=10, tag=快手极速版kaw参数

[MITM]
hostname = api3.ksapisrv.com, nebula.kuaishou.com, api.e.kuaishou.com

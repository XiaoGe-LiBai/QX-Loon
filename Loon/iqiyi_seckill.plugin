#!name = 爱奇艺尖叫之夜秒杀
#!desc = 修改商品库存状态点亮按钮 + 自动抢购
#!author = XiaoGe-LiBai
#!date = 2025-11-20

[Script]
# 响应拦截：点亮按钮 + 保存 Cookie
http-response ^https:\/\/act\.vip\.iqiyi\.com\/supermk\/seckill\/query\/activity\/timesList script-path=https://raw.githubusercontent.com/XiaoGe-LiBai/QX-Loon/refs/heads/main/Loon/Task/iqiyi_seckill.js, requires-body=true, timeout=10, tag=爱奇艺秒杀按钮点亮

# 定时任务：11.22 11:59:58 自动抢购（提前2秒发送请求）
cron "58 59 11 22 11 *" script-path=https://raw.githubusercontent.com/XiaoGe-LiBai/QX-Loon/refs/heads/main/Loon/Task/iqiyi_auto_buy.js, timeout=30, tag=爱奇艺自动抢购

[MITM]
hostname = act.vip.iqiyi.com

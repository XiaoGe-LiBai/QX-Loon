#!name = 爱奇艺尖叫之夜秒杀
#!desc = 点亮按钮 + 抓取完整 Cookie
#!author = XiaoGe-LiBai
#!date = 2025-11-21

[Script]
http-response ^https:\/\/act\.vip\.iqiyi\.com\/supermk\/seckill\/query\/activity\/timesList script-path=https://raw.githubusercontent.com/XiaoGe-LiBai/QX-Loon/refs/heads/main/Loon/Task/iqiyi_seckill.js, requires-body=true, timeout=10, tag=爱奇艺秒杀按钮点亮
http-request ^https:\/\/act\.vip\.iqiyi\.com\/supermk\/seckill\/action\/seckill script-path=https://raw.githubusercontent.com/XiaoGe-LiBai/QX-Loon/refs/heads/main/Loon/Task/iqiyi_capture_cookie.js, requires-body=true, timeout=10, tag=爱奇艺秒杀Cookie抓取

[MITM]
hostname = act.vip.iqiyi.com
